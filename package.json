{
  "name": "appverse",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AppVerse — a personal application marketplace and installable PWA launchpad.",
  "license": "MIT",
  "author": "Bhargavi",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run test:registry && npm run build:web",
    "build:web": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:registry": "vitest run src/data/registry.test.ts",
    "icons": "node scripts/generate-icons.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "capture": "node scripts/capture-screenshots.mjs && node scripts/optimise-screenshots.mjs",
    "optimise:screenshots": "node scripts/optimise-screenshots.mjs",
    "sync:github": "node scripts/sync-github.mjs",
    "verify:links": "node scripts/verify-links.mjs",
    "prebuild": "npm run sitemap",
    "predeploy": "npm run build"
  },
  "dependencies": {
    "lucide-react": "^0.545.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.5.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.64.1",
    "sharp": "^0.34.3",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.43.0",
    "vite": "^7.1.5",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
